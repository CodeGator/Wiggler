<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.5</ProductVersion>
    <OutputName>Wiggler-$(ProductVersion)-x64</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)..\target\wix\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)..\target\wixobj\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
